  "calculation": {
    "steps": [
      "1. Tentukan region (ID / GLOBAL) dan layanan yang paling cocok dari services[].",
      "2. subtotal = base + (max(0, jumlah_halaman - pages_included) x extra_page.price) + total harga fitur tambahan (kecuali yang ada di includes).",
      "3. total = subtotal x design_level x content_readiness x timeline.",
      "4. price_low = bulatkan(total, region.round_to); price_high = bulatkan(price_low x range_upper, region.round_to).",
      "5. Validasi ke region.min_price dan region.max_price.",
      "6. Bandingkan dengan reference_cases region yang sama — jika meleset >30%, tetap pakai hasil hitungan tapi set confidence 'low'."
    ],
    "range_upper": 1.2
  },
