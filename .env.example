# ── OpenAI (AI consultant) ───────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Any cheap model that supports Structured Outputs (json_schema), e.g. gpt-5-mini, gpt-4.1-mini
OPENAI_MODEL=gpt-5-mini
# Only for reasoning models (gpt-5*, o*): minimal | low | medium. Leave empty for gpt-4.x models.
OPENAI_REASONING_EFFORT=low

# ── Gmail SMTP (consultation + order emails) ─────────────────────────
# Requires 2-Step Verification, then create an App Password:
# Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Where new orders are delivered (defaults to GMAIL_USER)
OWNER_EMAIL=yourname@gmail.com

# Random string used to sign quote IDs (e.g. `openssl rand -hex 24`)
QUOTE_SECRET=change-me

# ── Diskon ───────────────────────────────────────────────────────────
# Promo klien pertama. Kosongkan baris mana pun untuk memakai nilai dari data/pricing.json.
# Naikkan PUBLIC_FOUNDING_TAKEN setiap satu klien deal. Set PERCENT atau SPOTS ke 0
# untuk mematikan promonya. Nilai PUBLIC_* ini memang terlihat di browser, dan itu wajar
# karena diskonnya diiklankan di website.
PUBLIC_FOUNDING_PERCENT=20
PUBLIC_FOUNDING_SPOTS=5
PUBLIC_FOUNDING_TAKEN=0
# Batas atas total diskon. Isi minimal sebesar (FOUNDING_PERCENT + persen kode promo terbesar),
# kalau kurang, potongan kode promo akan dipangkas otomatis.
PUBLIC_MAX_DISCOUNT_PERCENT=40
# Kode promo, format "KODE=persen" dipisah koma. Hanya dicek di server, jadi kodenya
# tidak pernah ikut ke browser. Kosongkan kalau belum ada kode promo.
PROMO_CODES=KENALANCEO=20

# ── Public site settings ─────────────────────────────────────────────
PUBLIC_SITE_URL=https://your-domain.com
# International format without "+" or spaces, e.g. 6281234567890
PUBLIC_WHATSAPP_NUMBER=6281234567890
PUBLIC_CONTACT_EMAIL=hello@your-domain.com
# Optional: Google Search Console HTML-tag verification token
PUBLIC_GSC_VERIFICATION=
# Optional: Cloudflare Turnstile (free bot protection). Leave both empty to disable.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
