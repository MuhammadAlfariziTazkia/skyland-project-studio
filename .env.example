# ── OpenAI (AI consultant) ───────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Any cheap model that supports Structured Outputs (json_schema), e.g. gpt-5-mini, gpt-4.1-mini
OPENAI_MODEL=gpt-5-mini
# Only for reasoning models (gpt-5*, o*): minimal | low | medium. Leave empty for gpt-4.x models.
OPENAI_REASONING_EFFORT=low

# ── Gmail SMTP (consultation + order emails) ─────────────────────────
# Requires 2-Step Verification, then create an App Password:
# Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Where new orders are delivered (defaults to GMAIL_USER)
OWNER_EMAIL=yourname@gmail.com

# Random string used to sign quote IDs (e.g. `openssl rand -hex 24`)
QUOTE_SECRET=change-me

# ── Public site settings ─────────────────────────────────────────────
PUBLIC_SITE_URL=https://your-domain.com
# International format without "+" or spaces, e.g. 6281234567890
PUBLIC_WHATSAPP_NUMBER=6281234567890
PUBLIC_CONTACT_EMAIL=hello@your-domain.com
# Optional: Google Search Console HTML-tag verification token
PUBLIC_GSC_VERIFICATION=
# Optional: Cloudflare Turnstile (free bot protection). Leave both empty to disable.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
