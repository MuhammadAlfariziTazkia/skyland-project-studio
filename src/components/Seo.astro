---
import { SITE } from '../config/site';
import { pairFor } from '../i18n/routes';
import type { Locale } from '../lib/schemas';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  ogAlt: string;
  jsonLd?: object[];
  noindex?: boolean;
}
const { locale, title, description, ogAlt, jsonLd = [], noindex = false } = Astro.props;
const site = (Astro.site?.toString() ?? SITE.url).replace(/\/$/, '');
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const canonical = site + path;
const pair = pairFor(path);
const ogImage = `${site}/og-${locale}.png`;
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
{pair && (
  <>
    <link rel="alternate" hreflang="en" href={site + pair.en} />
    <link rel="alternate" hreflang="id" href={site + pair.id} />
    <link rel="alternate" hreflang="x-default" href={site + pair.en} />
  </>
)}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={locale === 'id' ? 'id_ID' : 'en_US'} />
<meta property="og:locale:alternate" content={locale === 'id' ? 'en_US' : 'id_ID'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{SITE.gscVerification && <meta name="google-site-verification" content={SITE.gscVerification} />}
{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
