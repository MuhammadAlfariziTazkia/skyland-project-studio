---
import { SITE } from '../config/site';
import { pairFor } from '../i18n/routes';
import { LOCALES, type Locale } from '../lib/schemas';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  ogAlt: string;
  jsonLd?: object[];
  noindex?: boolean;
}
const { locale, title, description, ogAlt, jsonLd = [], noindex = false } = Astro.props;
/** Open Graph wants a full locale tag, not the short code. */
const OG_LOCALE: Record<Locale, string> = { en: 'en_US', id: 'id_ID', ja: 'ja_JP' };
const site = (Astro.site?.toString() ?? SITE.url).replace(/\/$/, '');
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const canonical = site + path;
const pair = pairFor(path);
const ogImage = `${site}/og-${locale}.png`;
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
{pair && (
  <>
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={site + pair[l]} />)}
    <link rel="alternate" hreflang="x-default" href={site + pair.en} />
  </>
)}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={OG_LOCALE[locale]} />
{LOCALES.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{SITE.gscVerification && <meta name="google-site-verification" content={SITE.gscVerification} />}
{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
