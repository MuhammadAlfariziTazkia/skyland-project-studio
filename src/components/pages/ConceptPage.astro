---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../landing/Header.astro';
import Footer from '../landing/Footer.astro';
import ConceptPricing from '../concept/ConceptPricing';
import { CONCEPT_VISUALS } from '../concept/visuals';
import { getDict } from '../../i18n';
import { CONCEPT_KEYS, ROUTES, conceptPath, servicePath, type ConceptKey } from '../../i18n/routes';
import { breadcrumbLd, conceptLd, organizationLd } from '../../lib/jsonld';
import type { Locale } from '../../lib/schemas';

interface Props { locale: Locale; concept: ConceptKey }
const { locale, concept } = Astro.props;
const t = getDict(locale);
const c = t.conceptPage;
const copy = t.work.concepts.find((x) => x.key === concept)!;
const v = CONCEPT_VISUALS[concept];

const site = (Astro.site?.toString() ?? '').replace(/\/$/, '');
const others = CONCEPT_KEYS.filter((k) => k !== concept);
const title = `${copy.name} — ${c.eyebrow} · Skyland`;
const DESC_SUFFIX: Record<Locale, string> = {
  en: 'See the feature breakdown and a fixed price, then order the version built for your business.',
  id: 'Lihat rincian fitur dan harga pastinya, lalu pesan versi untuk bisnis Anda.',
  ja: '機能の内訳と確定料金をご覧いただき、あなたの事業向けの版をご注文ください。',
};
const description = `${copy.desc} ${DESC_SUFFIX[locale]}`;
const jsonLd = [
  organizationLd(site, locale),
  conceptLd(site, locale, concept),
  breadcrumbLd([
    { name: t.servicePage.breadcrumbHome, url: site + ROUTES.home[locale] },
    { name: c.breadcrumbWork, url: `${site}${ROUTES.home[locale]}#work` },
    { name: copy.name, url: site + conceptPath(concept, locale) },
  ]),
];
---
<Base locale={locale} title={title} description={description} ogAlt={t.meta.ogAlt} jsonLd={jsonLd}>
  <Header locale={locale} />
  <main>
    <section class="hero" style={`--cbg:${v.bg};--cfg:${v.fg};--cac:${v.accent}`}>
      <div class="container grid">
        <div class="stack copy">
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href={ROUTES.home[locale]}>{t.servicePage.breadcrumbHome}</a><span>/</span><a href={`${ROUTES.home[locale]}#work`}>{c.breadcrumbWork}</a><span>/</span><span aria-current="page">{copy.name}</span>
          </nav>
          <span class="eyebrow">{copy.category}</span>
          <h1>{copy.name}</h1>
          <p class="tagline">&ldquo;{copy.tagline}&rdquo;</p>
          <p class="lead">{copy.desc}</p>
          <ul class="pills">{copy.highlights.map((h) => <li class="pill">{h}</li>)}</ul>
          <div class="cta-row">
            <a class="btn btn-primary" href="#scope">{c.cta} ↓</a>
            <a class="btn btn-ghost" href={copy.url} target="_blank" rel="noopener">{c.demo} ↗</a>
          </div>
        </div>
        <a class="visual" href={copy.url} target="_blank" rel="noopener" aria-label={c.demo}>
          <div class="browser">
            <div class="browser-bar"><i /><i /><i /><span>{copy.host}</span></div>
            <div class="shot"><Image src={v.shot} alt={t.work.desktopAlt(copy.name)} widths={[480, 720, 960]} sizes="(min-width: 1024px) 480px, 100vw" loading="eager" /></div>
          </div>
        </a>
      </div>
    </section>

    <section class="section scope" id="scope">
      <div class="container stack">
        <div class="head stack">
          <span class="eyebrow">{c.priceTitle}</span>
          <h2 class="h2">{copy.type}</h2>
          {/* Stated flatly rather than derived from a build-time quote, because the quote would be the
              locale's market and this page's one price comes from the visitor's device. Safe to state
              because "every concept has a genuinely fixed price, in every market" is a test; the panel
              below still says so itself if a scope ever turns into a range. */}
          <p class="lead">{c.priceNote}</p>
        </div>
        <ConceptPricing client:load locale={locale} concept={concept} consultHref={ROUTES.consult[locale]} />
      </div>
    </section>

    <section class="section note">
      <div class="container">
        <div class="card disclaimer stack">
          <h3>{c.mockupTitle}</h3>
          <p>{c.mockupText}</p>
          <a class="link-arrow" href={servicePath(copy.service, locale)}>{t.work.similar}: <b>{t.services_list[copy.service].name}</b> →</a>
        </div>
      </div>
    </section>

    <section class="section others">
      <div class="container stack">
        <h2 class="h2">{c.othersTitle}</h2>
        <ul class="other-grid">
          {others.map((k) => {
            const o = t.work.concepts.find((x) => x.key === k)!;
            return (
              <li>
                <a href={conceptPath(k, locale)} style={`--cbg:${CONCEPT_VISUALS[k].bg};--cac:${CONCEPT_VISUALS[k].accent}`}>
                  <span class="eyebrow">{o.category}</span>
                  <b>{o.name}</b>
                  <span class="fine">{o.type}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</Base>

<style>
  /*
   * global.css gives `.stack` a column direction but no gap, so every child here sat flush against the
   * next one: the eyebrow touched the h1, and the pills had nothing above them. Each stack on this page
   * states its own rhythm rather than relying on a parent that has none.
   */
  .stack { gap: 16px; }
  .hero .copy { gap: 14px; }
  .hero { background: var(--cbg); color: var(--cfg); padding: 32px 0 56px; }
  .hero .grid { display: grid; gap: 28px; align-items: start; }
  @media (min-width: 1024px) { .hero { padding: 40px 0 72px; } .hero .grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 48px; } }

  /* Breadcrumb and inline links carry a touch-sized hit area without changing how they look. */
  .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 8px; font-size: 13px; color: color-mix(in srgb, var(--cfg) 62%, transparent); margin-bottom: 8px; }
  .crumbs a { color: color-mix(in srgb, var(--cfg) 78%, transparent); text-decoration: none; display: inline-flex; align-items: center; min-height: 32px; padding: 4px 0; }
  .crumbs a:hover { color: var(--cfg); }
  .crumbs > span { display: inline-flex; align-items: center; min-height: 32px; }
  @media (pointer: coarse) { .crumbs a, .crumbs > span { min-height: 44px; } }

  .hero .eyebrow { color: var(--cac); }
  .hero h1 { font-size: clamp(30px, 4.4vw, 48px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.08; margin: 0; text-wrap: balance; }
  .tagline { font-family: var(--hand); font-size: clamp(20px, 2.4vw, 26px); color: var(--cac); margin: 0; }
  .hero .lead { color: color-mix(in srgb, var(--cfg) 76%, transparent); max-width: 56ch; }

  .pills { list-style: none; margin: 4px 0 2px; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .hero .pill { background: color-mix(in srgb, var(--cfg) 10%, transparent); border-color: color-mix(in srgb, var(--cfg) 18%, transparent); color: color-mix(in srgb, var(--cfg) 88%, transparent); }

  .cta-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
  .cta-row .btn-ghost { background: transparent; color: var(--cfg); border-color: color-mix(in srgb, var(--cfg) 28%, transparent); }
  .cta-row .btn-ghost:hover { border-color: var(--cfg); }

  .visual { display: block; text-decoration: none; }
  .browser { box-shadow: 0 24px 60px rgba(0, 0, 0, .35); }
  .browser-bar { background: color-mix(in srgb, var(--cbg) 82%, #fff); border-bottom-color: color-mix(in srgb, var(--cfg) 14%, transparent); }
  .browser-bar i { background: color-mix(in srgb, var(--cfg) 26%, transparent); }
  .browser-bar span { color: color-mix(in srgb, var(--cfg) 56%, transparent); background: color-mix(in srgb, var(--cfg) 8%, transparent); }
  .shot { height: 320px; overflow: hidden; background: #fff; -webkit-mask-image: linear-gradient(#000 72%, transparent); mask-image: linear-gradient(#000 72%, transparent); }
  .shot :global(img) { width: 100%; height: auto; display: block; }
  @media (min-width: 1024px) { .shot { height: 420px; } }

  .scope .head { gap: 10px; max-width: 62ch; margin-bottom: 24px; }
  .note .disclaimer { padding: 22px; gap: 10px; }
  .note h3 { margin: 0; font-size: 16px; }
  .note p { margin: 0; color: var(--muted); font-size: 14.5px; line-height: 1.6; }
  .link-arrow { color: var(--blue); font-weight: 600; font-size: 14px; text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; align-self: flex-start; }

  .others .container.stack { gap: 20px; }
  .others .h2 { font-size: clamp(22px, 2.6vw, 28px); }
  .other-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  @media (min-width: 640px) { .other-grid { grid-template-columns: repeat(3, 1fr); } }
  .other-grid a { display: flex; flex-direction: column; gap: 4px; padding: 18px; border-radius: var(--radius); background: var(--cbg); text-decoration: none; min-height: 100%; transition: transform .2s var(--ease); }
  .other-grid a:hover { transform: translateY(-2px); }
  .other-grid .eyebrow { color: var(--cac); font-size: 11px; }
  .other-grid b { color: #fff; font-size: 15.5px; }
  .other-grid .fine { color: rgba(255, 255, 255, .64); font-size: 13px; }
</style>
