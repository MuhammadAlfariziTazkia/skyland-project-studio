---
import Base from '../../layouts/Base.astro';
import Header from '../landing/Header.astro';
import Footer from '../landing/Footer.astro';
import Consultant from '../consult/Consultant';
import { SITE } from '../../config/site';
import { getDict } from '../../i18n';
import { ROUTES, SERVICE_KEYS, servicePath } from '../../i18n/routes';
import { breadcrumbLd, organizationLd } from '../../lib/jsonld';
import { typicalRange } from '../../lib/pricing';
import type { Locale } from '../../lib/schemas';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale);
const site = (Astro.site?.toString() ?? '').replace(/\/$/, '');
const copy = {
  en: {
    eyebrow: '✦ FREE AI CONSULTATION',
    h1: 'Get your website plan and fixed price in minutes',
    lead: 'Describe what you need. Our AI consultant maps it to pages and features from our public price list, shows you a homepage mockup and calculates a fixed price. No sign-up, no commitment.',
    how: 'How your price is calculated',
    howText: 'Every project starts from a base package for its website type. Extra pages are priced by complexity, and each feature has a fixed price in our catalog. The AI only picks the items; the total is calculated by code, so the same plan always gets the same price.',
    ranges: 'Typical price ranges',
  },
  id: {
    eyebrow: '✦ KONSULTASI AI GRATIS',
    h1: 'Dapatkan rencana website dan harga pasti dalam hitungan menit',
    lead: 'Ceritakan kebutuhan Anda. Konsultan AI kami mencocokkannya dengan halaman dan fitur dari daftar harga kami, menampilkan mockup homepage, dan menghitung harga pasti. Tanpa daftar, tanpa komitmen.',
    how: 'Bagaimana harga Anda dihitung',
    howText: 'Setiap proyek dimulai dari paket dasar sesuai jenis website. Halaman tambahan dihitung berdasarkan kompleksitas, dan setiap fitur punya harga tetap di katalog kami. AI hanya memilih item; totalnya dihitung oleh sistem, sehingga rencana yang sama selalu mendapat harga yang sama.',
    ranges: 'Kisaran harga umum',
  },
}[locale];
const jsonLd = [
  organizationLd(site, locale),
  breadcrumbLd([
    { name: t.servicePage.breadcrumbHome, url: site + ROUTES.home[locale] },
    { name: t.nav.cta, url: site + ROUTES.consult[locale] },
  ]),
];
---
<Base locale={locale} title={t.meta.consultTitle} description={t.meta.consultDescription} ogAlt={t.meta.ogAlt} jsonLd={jsonLd}>
  <Header locale={locale} />
  <main class="consult">
    <div class="container inner">
      <header class="intro">
        <span class="eyebrow">{copy.eyebrow}</span>
        <h1>{copy.h1}</h1>
        <p class="lead">{copy.lead}</p>
      </header>
      <Consultant client:load locale={locale} whatsapp={SITE.whatsapp} privacyHref={ROUTES.privacy[locale]} turnstileSiteKey={SITE.turnstileSiteKey} />
      <section class="explain">
        <div class="stack">
          <h2>{copy.how}</h2>
          <p>{copy.howText}</p>
        </div>
        <div class="stack">
          <h2>{copy.ranges}</h2>
          <ul>
            {SERVICE_KEYS.map((k) => (
              <li><a href={servicePath(k, locale)}>{t.services_list[k].name}</a><b>{typicalRange(k, t.currency)}</b></li>
            ))}
          </ul>
        </div>
      </section>
    </div>
  </main>
  <Footer locale={locale} />
</Base>

<style>
  .consult { background: linear-gradient(180deg, #fff 0%, #f1f6ff 420px, #f5f8fd 100%); }
  .inner { padding-top: 32px; padding-bottom: 72px; display: flex; flex-direction: column; gap: 28px; max-width: 1120px; }
  @media (min-width: 768px) { .inner { padding-top: 56px; gap: 36px; } }
  .intro { display: flex; flex-direction: column; gap: 12px; max-width: 760px; }
  h1 { font-size: clamp(28px, 4.2vw, 46px); line-height: 1.08; letter-spacing: -0.035em; font-weight: 800; text-wrap: balance; }
  .explain { display: grid; gap: 28px; padding-top: 20px; border-top: 1px solid var(--line); }
  @media (min-width: 900px) { .explain { grid-template-columns: 1fr 1fr; gap: 48px; } }
  .explain .stack { gap: 10px; }
  .explain h2 { font-size: 20px; letter-spacing: -0.02em; }
  .explain p { font-size: 14.5px; color: var(--muted); line-height: 1.65; }
  .explain ul { list-style: none; margin: 0; padding: 0; }
  .explain li { display: flex; justify-content: space-between; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  .explain li a { color: var(--ink-2); font-weight: 600; }
  .explain li b { white-space: nowrap; }
</style>
