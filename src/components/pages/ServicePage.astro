---
import Base from '../../layouts/Base.astro';
import Header from '../landing/Header.astro';
import Footer from '../landing/Footer.astro';
import ServiceIllustration from '../illustrations/ServiceIllustration.astro';
import pricing from '../../../data/pricing.json';
import { getDict } from '../../i18n';
import { ROUTES, SERVICE_KEYS, servicePath, type ServiceKey } from '../../i18n/routes';
import { breadcrumbLd, faqLd, organizationLd, serviceLd } from '../../lib/jsonld';
import { formatPrice, typicalRange } from '../../lib/pricing';
import type { Locale } from '../../lib/schemas';

interface Props { locale: Locale; service: ServiceKey }
const { locale, service } = Astro.props;
const t = getDict(locale);
const sp = t.servicePage;
const s = t.services_list[service];
const type = pricing.projectTypes[service];
const feats = pricing.features as Record<string, { name: Record<Locale, string> }>;
const site = (Astro.site?.toString() ?? '').replace(/\/$/, '');
const faqs = [...s.seo.faqs, ...t.faq.items.slice(1, 3)];
const jsonLd = [
  organizationLd(site, locale),
  serviceLd(site, locale, service),
  faqLd(faqs),
  breadcrumbLd([
    { name: sp.breadcrumbHome, url: site + ROUTES.home[locale] },
    { name: sp.breadcrumbServices, url: `${site}${ROUTES.home[locale]}#services` },
    { name: s.name, url: site + servicePath(service, locale) },
  ]),
];
---
<Base locale={locale} title={s.seo.title} description={s.seo.description} ogAlt={t.meta.ogAlt} jsonLd={jsonLd}>
  <Header locale={locale} />
  <main>
    <section class="hero">
      <div class="container grid">
        <div class="stack copy">
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href={ROUTES.home[locale]}>{sp.breadcrumbHome}</a><span>/</span><a href={`${ROUTES.home[locale]}#services`}>{sp.breadcrumbServices}</a><span>/</span><span aria-current="page">{s.name}</span>
          </nav>
          <h1>{s.seo.h1}</h1>
          <p class="lead big">{s.seo.intro}</p>
          <div class="facts">
            <div><span>{sp.startsFrom}</span><b>{formatPrice(type.basePrice[t.currency], t.currency)}</b></div>
            <div><span>{sp.typical}</span><b>{typicalRange(service, t.currency)}</b></div>
            <div><span>{sp.timeline}</span><b>{sp.weeks(type.timelineWeeks[0], type.timelineWeeks[1])}</b></div>
          </div>
          <div class="ctas">
            <a class="btn btn-primary" href={ROUTES.consult[locale]}>{t.how.cta} →</a>
            <a class="btn btn-ghost" href={`${ROUTES.home[locale]}#work`}>{t.hero.secondary}</a>
          </div>
        </div>
        <div class="visual" data-reveal>
          <div class="ill"><ServiceIllustration kind={service} headline={s.headline} url={s.url} idr={locale === 'id'} /></div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container two">
        <div class="stack" data-reveal>
          <h2 class="h2 sm">{sp.benefits}</h2>
          <ul class="benefits">
            {s.seo.benefits.map(([title, desc]) => <li><b>{title}</b><span>{desc}</span></li>)}
          </ul>
        </div>
        <div class="stack cards" data-reveal>
          <div class="card box">
            <h3>{sp.packageIncludes}</h3>
            <ul class="ticks">
              <li>{sp.pages(type.includedPages)}</li>
              {type.includedFeatures.map((f) => <li>{feats[f]?.name[locale]}</li>)}
            </ul>
          </div>
          <div class="card box">
            <h3>{sp.included}</h3>
            <ul class="ticks">{sp.includedItems.map((i) => <li>{i}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section soft">
      <div class="container two">
        <h2 class="h2 sm" data-reveal>{sp.faq}</h2>
        <div class="faq" data-reveal>
          {faqs.map(([q, a], i) => (
            <details open={i === 0}><summary>{q}</summary><p>{a}</p></details>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="cta" data-reveal>
          <div class="stack"><h2>{sp.ctaTitle}</h2><p>{sp.ctaText}</p></div>
          <a class="btn light" href={ROUTES.consult[locale]}>{t.how.cta} →</a>
        </div>
        <nav class="others" aria-label={sp.other}>
          <b>{sp.other}</b>
          <div>{SERVICE_KEYS.filter((k) => k !== service).map((k) => <a href={servicePath(k, locale)}>{t.services_list[k].name}</a>)}</div>
        </nav>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</Base>

<style>
  .hero { background: linear-gradient(180deg, #fff 0%, #edf3ff 100%); }
  .grid { display: grid; gap: 36px; align-items: center; padding-top: 32px; padding-bottom: 56px; }
  @media (min-width: 1024px) { .grid { grid-template-columns: 1.1fr 1fr; gap: 56px; padding-top: 56px; padding-bottom: 80px; } }
  .copy { gap: 20px; min-width: 0; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 6px; font-size: 13px; color: var(--faint); }
  .crumbs a { color: var(--muted); }
  h1 { font-size: clamp(30px, 4.4vw, 50px); line-height: 1.07; letter-spacing: -0.035em; font-weight: 800; text-wrap: balance; }
  .big { font-size: 17px; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; }
  .facts div { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 12px 14px; display: flex; flex-direction: column; gap: 2px; }
  .facts span { font-size: 12px; color: var(--muted-2); }
  .facts b { font-size: 17px; letter-spacing: -0.01em; }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  @media (max-width: 479px) { .ctas .btn { flex: 1 1 100%; } }
  .visual { min-width: 0; }
  .ill { aspect-ratio: 5 / 4; padding: clamp(14px, 4%, 28px); border-radius: 24px; background: #eef3ff; border: 1px solid var(--line); box-shadow: 0 30px 60px rgba(36, 89, 224, .1); }
  .two { display: grid; gap: 32px; }
  @media (min-width: 960px) { .two { grid-template-columns: 1fr 1fr; gap: 56px; } }
  .h2.sm { font-size: clamp(24px, 3vw, 34px); }
  .stack { gap: 18px; }
  .benefits { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .benefits li { display: flex; flex-direction: column; gap: 4px; padding-left: 18px; border-left: 3px solid var(--blue-soft); }
  .benefits span { color: var(--muted); font-size: 15px; line-height: 1.6; }
  .cards { gap: 16px; }
  .box { padding: 20px 22px; }
  .box h3 { font-size: 16px; margin-bottom: 12px; }
  .ticks { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: 14.5px; color: var(--ink-2); }
  .ticks li::before { content: '✓'; color: var(--green); font-weight: 800; margin-right: 10px; }
  .soft { background: var(--bg-soft); }
  .faq { border-top: 1px solid var(--line); }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; padding: 16px 0; font-weight: 600; font-size: 15.5px; }
  .faq p { padding: 0 0 18px; color: var(--muted); line-height: 1.65; font-size: 14.5px; }
  .cta { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px; background: linear-gradient(135deg, #1d4ed8, #2f6bff); color: #fff; border-radius: 24px; padding: clamp(24px, 4vw, 44px); }
  .cta .stack { gap: 8px; max-width: 620px; }
  .cta h2 { font-size: clamp(22px, 3vw, 32px); letter-spacing: -0.02em; }
  .cta p { color: #dbe6ff; line-height: 1.6; }
  .light { background: #fff; color: #1d4ed8; font-weight: 700; }
  .light:hover { color: #1d4ed8; transform: translateY(-2px); }
  @media (max-width: 479px) { .light { width: 100%; } }
  .others { margin-top: 40px; display: flex; flex-direction: column; gap: 12px; }
  .others div { display: flex; flex-wrap: wrap; gap: 8px; }
  .others a { font-size: 13.5px; font-weight: 600; color: var(--ink-2); border: 1px solid var(--line); border-radius: 999px; padding: 8px 14px; }
  .others a:hover { border-color: #b9ccf5; }
</style>
