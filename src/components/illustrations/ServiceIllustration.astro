---
// Hand-built mini website mockups, one per service type. Sized with container query units
// so they stay crisp and proportional from phone to desktop.
import type { ServiceKey } from '../../i18n/routes';

interface Props { kind: ServiceKey; headline: string; url: string; brand?: string; idr?: boolean }
const { kind, headline, url, brand = 'Brand', idr = false } = Astro.props;
const money = (usd: number) => (idr ? `Rp${usd * 10}rb` : `$${usd}`);
const days = Array.from({ length: 28 }, (_, i) => i + 1);
---
<div class="browser ill-frame" aria-hidden="true">
  <div class="browser-bar"><i></i><i></i><i></i><span>{url}</span></div>
  <div class:list={['ill', kind]}>
    {kind === 'company_profile' && (
      <>
        <div class="nav"><b>{brand}</b><span class="navl"><i></i><i></i><i></i><i class="btnx"></i></span></div>
        <div class="cp-hero">
          <div class="cp-copy"><strong class="hl">{headline}</strong><i class="line w80"></i><i class="line w60"></i><span class="cta">→</span></div>
          <div class="cp-img"><span class="b1"></span><span class="b2"></span><span class="b3"></span><span class="sun"></span></div>
        </div>
        <div class="logos"><i></i><i></i><i></i><i></i><i></i></div>
        <div class="cards3"><div><span class="ico">◆</span><i class="line w70"></i><i class="line w50"></i></div><div><span class="ico">●</span><i class="line w70"></i><i class="line w50"></i></div><div><span class="ico">▲</span><i class="line w70"></i><i class="line w50"></i></div></div>
      </>
    )}
    {kind === 'landing' && (
      <>
        <div class="lp">
          <span class="tag">NEW · 2026</span>
          <strong class="hl center">{headline}</strong>
          <div class="count"><span>02<small>d</small></span><span>14<small>h</small></span><span>36<small>m</small></span></div>
          <span class="cta wide">Pre-order →</span>
          <div class="product"><span class="bottle"></span><span class="shadow"></span></div>
        </div>
      </>
    )}
    {kind === 'online_store' && (
      <>
        <div class="nav"><b>{brand}</b><span class="navl"><i></i><i></i><span class="cart">🛒<em>3</em></span></span></div>
        <strong class="hl small">{headline}</strong>
        <div class="grid6">
          {['#f4c7a1', '#b9d7a8', '#f2e2a4', '#a9c8e8', '#e7b7c8', '#cbbfe6'].map((c, i) => (
            <div class="prod"><span class="pimg" style={`background:${c}`}></span><i class="line w70"></i><b class="price">{money([24, 38, 19, 42, 31, 27][i])}</b></div>
          ))}
        </div>
        <div class="drawer"><b>Cart</b><div class="ci"><span style="background:#f4c7a1"></span><i class="line w60"></i></div><div class="ci"><span style="background:#a9c8e8"></span><i class="line w60"></i></div><span class="cta wide">Checkout</span></div>
      </>
    )}
    {kind === 'portfolio' && (
      <>
        <div class="pf-head"><span class="avatar"></span><strong class="hl">{headline}</strong></div>
        <div class="masonry">
          <span style="background:linear-gradient(135deg,#8b5cf6,#ec4899);grid-row:span 2"></span>
          <span style="background:linear-gradient(135deg,#f59e0b,#f97316)"></span>
          <span style="background:linear-gradient(135deg,#06b6d4,#3b82f6);grid-row:span 2"></span>
          <span style="background:linear-gradient(135deg,#10b981,#84cc16)"></span>
          <span style="background:linear-gradient(135deg,#1e293b,#475569)"></span>
          <span style="background:linear-gradient(135deg,#f43f5e,#fb7185)"></span>
        </div>
      </>
    )}
    {kind === 'lms' && (
      <div class="lms-wrap">
        <aside>
          <b>Modules</b>
          {['done', 'done', 'done', 'now', '', ''].map((s) => <div class:list={['lesson', s]}><span></span><i class="line"></i></div>)}
        </aside>
        <div class="lms-main">
          <strong class="hl small">{headline}</strong>
          <div class="player"><span class="play">▶</span><div class="bar"><i style="width:38%"></i></div></div>
          <div class="prog"><span>Progress</span><div class="bar"><i style="width:64%"></i></div><b>64%</b></div>
          <div class="badges"><span>✓ Quiz 3</span><span>🏅 Certificate</span></div>
        </div>
      </div>
    )}
    {kind === 'booking' && (
      <div class="bk">
        <strong class="hl small">{headline}</strong>
        <div class="bk-body">
          <div class="cal">
            <div class="cal-h"><b>October</b><span>‹ ›</span></div>
            <div class="days">{days.map((d) => <span class:list={{ sel: d === 16, off: d % 7 === 0 }}>{d}</span>)}</div>
          </div>
          <div class="slots">
            {['09:00', '10:30', '13:00', '15:30'].map((s, i) => <span class:list={{ on: i === 1 }}>{s}</span>)}
            <span class="cta wide">Confirm →</span>
          </div>
        </div>
      </div>
    )}
    {kind === 'web_app' && (
      <div class="app">
        <aside><span class="logo-sq"></span><i></i><i class="on"></i><i></i><i></i></aside>
        <div class="app-main">
          <strong class="hl small">{headline}</strong>
          <div class="kpis"><div><small>MRR</small><b>$12.4k</b><em>+18%</em></div><div><small>Users</small><b>3,208</b><em>+9%</em></div><div><small>Churn</small><b>1.2%</b><em class="down">-0.4</em></div></div>
          <div class="chart">
            <svg viewBox="0 0 200 60" preserveAspectRatio="none"><defs><linearGradient id="g-app" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#6a9bff" stop-opacity=".5" /><stop offset="1" stop-color="#6a9bff" stop-opacity="0" /></linearGradient></defs><path d="M0 50 L20 44 L40 46 L60 36 L80 38 L100 28 L120 30 L140 20 L160 22 L180 12 L200 8 L200 60 L0 60Z" fill="url(#g-app)" /><path d="M0 50 L20 44 L40 46 L60 36 L80 38 L100 28 L120 30 L140 20 L160 22 L180 12 L200 8" fill="none" stroke="#8fb4ff" stroke-width="2" vector-effect="non-scaling-stroke" /></svg>
          </div>
        </div>
      </div>
    )}
    {kind === 'blog' && (
      <>
        <div class="nav"><b class="serif">{brand}</b><span class="navl"><i></i><i></i><i></i></span></div>
        <div class="feat"><span class="fimg"></span><div><span class="tag">FEATURED</span><strong class="hl serif">{headline}</strong><i class="line w80"></i><i class="line w60"></i></div></div>
        <div class="posts">{['#d8c3a5', '#a5c4d8', '#c3d8a5'].map((c) => <div><span style={`background:${c}`}></span><i class="line w80"></i><i class="line w50"></i></div>)}</div>
      </>
    )}
  </div>
</div>

<style>
  .ill-frame { height: 100%; container-type: inline-size; }
  .ill { position: relative; flex: 1; min-height: 0; overflow: hidden; padding: 4.5cqw; display: flex; flex-direction: column; gap: 3cqw; font-size: 2.4cqw; }
  .hl { display: block; font-size: 4.6cqw; line-height: 1.1; letter-spacing: -0.02em; font-weight: 800; }
  .hl.small { font-size: 3.8cqw; }
  .hl.center { text-align: center; }
  .serif { font-family: Georgia, 'Times New Roman', serif; }
  .line { display: block; height: 1.4cqw; border-radius: 1cqw; background: currentColor; opacity: .14; }
  .w80 { width: 80%; } .w70 { width: 70%; } .w60 { width: 60%; } .w50 { width: 50%; }
  .cta { align-self: flex-start; display: inline-flex; align-items: center; justify-content: center; background: #2459e0; color: #fff; border-radius: 99px; padding: 1.4cqw 3cqw; font-weight: 700; font-size: 2.3cqw; }
  .cta.wide { align-self: stretch; }
  .nav { display: flex; justify-content: space-between; align-items: center; font-size: 2.6cqw; }
  .navl { display: flex; gap: 2cqw; align-items: center; }
  .navl i { width: 6cqw; height: 1.3cqw; border-radius: 1cqw; background: currentColor; opacity: .18; }
  .navl .btnx { width: 9cqw; height: 3.6cqw; background: #2459e0; opacity: 1; border-radius: 99px; }
  .tag { align-self: flex-start; font-size: 1.9cqw; font-weight: 800; letter-spacing: .1em; padding: .8cqw 1.8cqw; border-radius: 99px; background: rgba(255, 255, 255, .7); }

  /* company profile */
  .company_profile { background: linear-gradient(180deg, #eef3ff, #fff); color: #0b1a3a; gap: 2.6cqw; }
  .cp-hero { display: grid; grid-template-columns: 1.1fr 1fr; gap: 4cqw; align-items: center; }
  .cp-copy { display: flex; flex-direction: column; gap: 2cqw; }
  .cp-img { position: relative; aspect-ratio: 1.45; border-radius: 3cqw; background: linear-gradient(160deg, #3b7bff, #1d4ed8); overflow: hidden; }
  .cp-img span { position: absolute; bottom: 0; background: rgba(255, 255, 255, .88); border-radius: 1cqw 1cqw 0 0; }
  .b1 { left: 12%; width: 18%; height: 55%; } .b2 { left: 36%; width: 22%; height: 78%; } .b3 { left: 64%; width: 16%; height: 45%; }
  .cp-img .sun { top: 12%; right: 12%; bottom: auto; width: 14%; aspect-ratio: 1; border-radius: 50%; background: #ffd66b; }
  .logos { display: flex; justify-content: space-between; gap: 3cqw; padding: 1cqw 0; }
  .logos i { flex: 1; height: 2cqw; border-radius: 1cqw; background: #0b1a3a; opacity: .1; }
  .cards3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.4cqw; }
  .cards3 > div { background: #fff; border: 1px solid #e3eaf6; border-radius: 2cqw; padding: 2cqw; display: flex; flex-direction: column; gap: 1.2cqw; }
  .ico { width: 5cqw; height: 5cqw; border-radius: 1.4cqw; background: #eaf0ff; color: #2459e0; display: flex; align-items: center; justify-content: center; font-size: 2.2cqw; }

  /* landing */
  .landing { background: radial-gradient(circle at 50% 110%, #ffb070 0%, #fff3e6 55%); color: #3b230c; }
  .lp { display: flex; flex-direction: column; align-items: center; gap: 2.6cqw; height: 100%; text-align: center; }
  .lp .tag { align-self: center; background: #3b230c; color: #fff3e6; }
  .lp .hl { font-size: 6cqw; max-width: 80%; }
  .count { display: flex; gap: 2cqw; }
  .count span { background: #fff; border-radius: 2cqw; padding: 1.4cqw 2.4cqw; font-weight: 800; font-size: 3.6cqw; box-shadow: 0 1cqw 3cqw rgba(59, 35, 12, .12); }
  .count small { font-size: 2cqw; opacity: .6; margin-left: .4cqw; }
  .lp .cta { align-self: center; background: #ea580c; padding: 1.8cqw 6cqw; }
  .product { position: relative; flex: 1; width: 30%; display: flex; align-items: flex-end; justify-content: center; }
  .bottle { width: 60%; height: 100%; min-height: 12cqw; border-radius: 4cqw 4cqw 2cqw 2cqw; background: linear-gradient(180deg, #7c2d12, #ea580c); position: relative; z-index: 1; }
  .shadow { position: absolute; bottom: -1cqw; width: 100%; height: 3cqw; border-radius: 50%; background: rgba(59, 35, 12, .2); }

  /* store */
  .online_store { background: #f6f8f2; color: #1f2e1a; }
  .grid6 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.4cqw; width: 66%; }
  .prod { background: #fff; border-radius: 2cqw; padding: 1.6cqw; display: flex; flex-direction: column; gap: 1.2cqw; }
  .pimg { aspect-ratio: 1.2; border-radius: 1.4cqw; }
  .price { font-size: 2.3cqw; }
  .cart { position: relative; font-size: 3cqw; }
  .cart em { position: absolute; top: -1.4cqw; right: -1.8cqw; font-style: normal; font-size: 1.8cqw; background: #16a36a; color: #fff; border-radius: 99px; padding: 0 1cqw; }
  .drawer { position: absolute; right: 4cqw; top: 14cqw; bottom: 4cqw; width: 27%; background: #fff; border-radius: 2.4cqw; box-shadow: 0 2cqw 6cqw rgba(31, 46, 26, .18); padding: 2.4cqw; display: flex; flex-direction: column; gap: 2cqw; }
  .ci { display: flex; gap: 1.6cqw; align-items: center; }
  .ci span { width: 6cqw; height: 6cqw; border-radius: 1.2cqw; flex: none; }
  .ci .line { flex: 1; }
  .drawer .cta { margin-top: auto; background: #16a36a; }

  /* portfolio */
  .portfolio { background: #faf7ff; color: #2a1745; }
  .pf-head { display: flex; align-items: center; gap: 3cqw; }
  .avatar { flex: none; width: 10cqw; height: 10cqw; border-radius: 50%; background: radial-gradient(circle at 50% 38%, #f3d2b3 0 26%, transparent 27%), radial-gradient(circle at 50% 100%, #7c3aed 0 45%, transparent 46%), #e9e1f6; }
  .pf-head .hl { max-width: 70%; }
  .masonry { flex: 1; display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: 1fr; gap: 2cqw; min-height: 0; }
  .masonry span { border-radius: 2cqw; }

  /* lms */
  .lms { background: #eef8f6; color: #0e3a33; padding: 0; }
  .lms-wrap { display: grid; grid-template-columns: 30% 1fr; height: 100%; }
  .lms aside { background: #0e3a33; color: #d8efea; padding: 3.6cqw 3cqw; display: flex; flex-direction: column; gap: 2.2cqw; }
  .lesson { display: flex; gap: 1.6cqw; align-items: center; }
  .lesson span { flex: none; width: 3cqw; height: 3cqw; border-radius: 50%; border: .4cqw solid #5fbfad; }
  .lesson.done span { background: #5fbfad; }
  .lesson.now span { border-color: #fff; box-shadow: 0 0 0 .6cqw rgba(255, 255, 255, .25); }
  .lesson .line { flex: 1; opacity: .3; }
  .lms-main { padding: 3.6cqw; display: flex; flex-direction: column; gap: 2.6cqw; }
  .player { position: relative; flex: 1; min-height: 16cqw; border-radius: 2.4cqw; background: linear-gradient(135deg, #134e44, #1f7a6a); display: flex; align-items: center; justify-content: center; }
  .play { width: 9cqw; height: 9cqw; border-radius: 50%; background: #fff; color: #0e3a33; display: flex; align-items: center; justify-content: center; font-size: 3.4cqw; padding-left: .6cqw; }
  .player .bar { position: absolute; left: 3cqw; right: 3cqw; bottom: 2.4cqw; }
  .bar { height: 1.2cqw; border-radius: 1cqw; background: rgba(255, 255, 255, .3); overflow: hidden; }
  .bar i { display: block; height: 100%; background: #5fbfad; border-radius: 1cqw; }
  .prog { display: flex; align-items: center; gap: 2cqw; font-size: 2.2cqw; }
  .prog .bar { flex: 1; background: #cfe7e2; }
  .badges { display: flex; gap: 2cqw; }
  .badges span { background: #fff; border-radius: 99px; padding: 1cqw 2.2cqw; font-weight: 700; font-size: 2.1cqw; }

  /* booking */
  .booking { background: #fff5f7; color: #4a1526; }
  .bk { display: flex; flex-direction: column; gap: 3cqw; height: 100%; }
  .bk-body { flex: 1; display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 3cqw; min-height: 0; }
  .cal { min-width: 0; min-height: 0; overflow: hidden; background: #fff; border-radius: 2.4cqw; padding: 2.6cqw; box-shadow: 0 1cqw 4cqw rgba(74, 21, 38, .08); display: flex; flex-direction: column; gap: 2cqw; }
  .cal-h { display: flex; justify-content: space-between; font-size: 2.6cqw; }
  .days { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); grid-auto-rows: 1fr; gap: .8cqw; flex: 1; min-height: 0; }
  .days span { display: flex; align-items: center; justify-content: center; border-radius: 1.4cqw; font-size: 2cqw; font-weight: 600; min-height: 0; }
  .days .off { opacity: .3; }
  .days .sel { background: radial-gradient(circle closest-side, #e11d48 0 92%, transparent 96%); color: #fff; }
  .slots { display: flex; flex-direction: column; gap: 1.8cqw; }
  .slots span { background: #fff; border: 1px solid #f9d0da; border-radius: 1.6cqw; padding: 1.6cqw; text-align: center; font-weight: 700; font-size: 2.3cqw; }
  .slots span.on { background: #4a1526; border-color: #4a1526; color: #fff; }
  .slots .cta { margin-top: auto; background: #e11d48; border: 0; }

  /* web app */
  .web_app { background: #0b1433; color: #e6ecff; padding: 0; }
  .app { display: grid; grid-template-columns: 11% 1fr; height: 100%; }
  .app aside { background: #081029; display: flex; flex-direction: column; align-items: center; gap: 3cqw; padding: 3.6cqw 0; }
  .logo-sq { width: 5.4cqw; height: 5.4cqw; border-radius: 1.6cqw; background: linear-gradient(135deg, #6a9bff, #2459e0); }
  .app aside i { width: 4cqw; height: 4cqw; border-radius: 1.2cqw; background: rgba(255, 255, 255, .12); }
  .app aside i.on { background: #6a9bff; }
  .app-main { padding: 3.6cqw; display: flex; flex-direction: column; gap: 2.6cqw; min-width: 0; }
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2cqw; }
  .kpis div { background: #121d45; border: 1px solid #1d2b5e; border-radius: 2cqw; padding: 2cqw; display: flex; flex-direction: column; gap: .4cqw; }
  .kpis small { font-size: 1.9cqw; opacity: .6; }
  .kpis b { font-size: 3.4cqw; }
  .kpis em { font-style: normal; font-size: 1.9cqw; color: #4ade80; }
  .kpis em.down { color: #4ade80; }
  .chart { flex: 1; min-height: 0; background: #121d45; border: 1px solid #1d2b5e; border-radius: 2cqw; padding: 2cqw; }
  .chart svg { width: 100%; height: 100%; }

  /* blog */
  .blog { background: #faf8f3; color: #2b261c; }
  .feat { display: grid; grid-template-columns: 1fr 1.1fr; gap: 3cqw; align-items: center; }
  .fimg { aspect-ratio: 1.3; border-radius: 2cqw; background: linear-gradient(160deg, #e8d5b5 0 45%, #b08d57 45% 60%, #6b5433 60%); }
  .feat > div { display: flex; flex-direction: column; gap: 1.8cqw; }
  .feat .tag { background: #2b261c; color: #faf8f3; }
  .posts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.4cqw; }
  .posts div { display: flex; flex-direction: column; gap: 1.2cqw; }
  .posts span { aspect-ratio: 1.6; border-radius: 1.6cqw; }
</style>
