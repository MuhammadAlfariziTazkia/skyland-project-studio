---
import type { Locale } from '../lib/schemas';

/**
 * The flag for a locale, drawn inline.
 *
 * Emoji flags (🇮🇩 🇺🇸 🇯🇵) are not an option: Windows ships no glyphs for them, so they render as the
 * two letters of the country code and the switcher would look broken on a large share of visitors'
 * machines. These are deliberately plain shapes, sized to read at 22px inside a round badge — the badge
 * clips them with CSS, so there are no SVG `clipPath` ids to collide when several are on one page.
 *
 * `en` is drawn as the US flag because that is what the owner asked for ("inggris/amerika"); the stripe
 * count is reduced from thirteen, which is mud at this size.
 */
interface Props { locale: Locale; class?: string }
const { locale, class: cls = '' } = Astro.props;
---
{locale === 'id' && (
  <svg class={`flag-svg ${cls}`} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <rect width="24" height="12" fill="#ce1126" />
    <rect y="12" width="24" height="12" fill="#fff" />
  </svg>
)}
{locale === 'ja' && (
  <svg class={`flag-svg ${cls}`} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <rect width="24" height="24" fill="#fff" />
    <circle cx="12" cy="12" r="7" fill="#bc002d" />
  </svg>
)}
{locale === 'en' && (
  <svg class={`flag-svg ${cls}`} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <rect width="24" height="24" fill="#fff" />
    <g fill="#b22234">
      <rect width="24" height="3.43" />
      <rect y="6.86" width="24" height="3.43" />
      <rect y="13.71" width="24" height="3.43" />
      <rect y="20.57" width="24" height="3.43" />
    </g>
    <rect width="12" height="10.29" fill="#3c3b6e" />
    <path fill="#fff" d="M6 2.4l.73 2.25h2.37l-1.92 1.4.74 2.25L6 6.9 4.08 8.3l.74-2.25L2.9 4.65h2.37z" />
  </svg>
)}

<style>
  .flag-svg { display: block; width: 100%; height: 100%; }
</style>
