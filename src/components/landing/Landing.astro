---
import Base from '../../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Services from './Services.astro';
import HowItWorks from './HowItWorks.astro';
import Work from './Work.astro';
import Why from './Why.astro';
import Faq from './Faq.astro';
import Offer from './Offer.astro';
import Footer from './Footer.astro';
import { getDict } from '../../i18n';
import { faqLd, organizationLd, personLd, websiteLd } from '../../lib/jsonld';
import type { Locale } from '../../lib/schemas';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale);
const site = (Astro.site?.toString() ?? '').replace(/\/$/, '');
const jsonLd = [organizationLd(site, locale), personLd(site, locale), websiteLd(site, locale), faqLd(t.faq.items)];
---
<Base locale={locale} title={t.meta.homeTitle} description={t.meta.homeDescription} ogAlt={t.meta.ogAlt} jsonLd={jsonLd}>
  <Header locale={locale} />
  <main>
    <Hero locale={locale} />
    <Services locale={locale} />
    <HowItWorks locale={locale} />
    <Work locale={locale} />
    <Why locale={locale} />
    <Faq locale={locale} />
    <Offer locale={locale} />
  </main>
  <Footer locale={locale} />
</Base>
