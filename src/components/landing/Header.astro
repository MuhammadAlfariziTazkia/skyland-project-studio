---
import Logo from '../Logo.astro';
import { getDict, otherLocale } from '../../i18n';
import { ROUTES, pairFor } from '../../i18n/routes';
import type { Locale } from '../../lib/schemas';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale);
const home = ROUTES.home[locale];
const isHome = Astro.url.pathname === home || Astro.url.pathname + '/' === home;
const anchor = (id: string) => (isHome ? `#${id}` : `${home}#${id}`);
const alt = otherLocale(locale);
const altHref = pairFor(Astro.url.pathname)?.[alt] ?? ROUTES.home[alt];
const links = [
  ['services', t.nav.services],
  ['how', t.nav.how],
  ['work', t.nav.work],
  ['why', t.nav.why],
  ['faq', t.nav.faq],
];
---
<header class="site-header" data-header>
  <nav class="container nav" aria-label="Main">
    <Logo href={home} />
    <div class="links" id="nav-links" data-nav-links>
      {links.map(([id, label]) => <a href={anchor(id)} data-nav-link>{label}</a>)}
      <a class="lang" href={altHref} hreflang={alt} lang={alt} data-lang-switch>
        <span aria-hidden="true">🌐</span> {t.nav.switchLang}
      </a>
      <a class="btn btn-primary btn-sm mobile-cta" href={ROUTES.consult[locale]}>{t.nav.cta} →</a>
    </div>
    <div class="right">
      <a class="lang-short" href={altHref} hreflang={alt} lang={alt} aria-label={t.nav.switchLang} data-lang-switch>{t.nav.switchLangShort}</a>
      <a class="btn btn-primary btn-sm desktop-cta" href={ROUTES.consult[locale]}>{t.nav.cta} →</a>
      <button class="burger" type="button" aria-controls="nav-links" aria-expanded="false" data-burger>
        <span class="sr-only" data-burger-label data-open={t.nav.menu} data-close={t.nav.close}>{t.nav.menu}</span>
        <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </nav>
</header>

<script>
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const header = document.querySelector<HTMLElement>('[data-header]');
  const label = document.querySelector<HTMLElement>('[data-burger-label]');
  const set = (open: boolean) => {
    header?.classList.toggle('open', open);
    burger?.setAttribute('aria-expanded', String(open));
    if (label) label.textContent = (open ? label.dataset.close : label.dataset.open) ?? '';
    document.body.style.overflow = open ? 'hidden' : '';
  };
  burger?.addEventListener('click', () => set(!header?.classList.contains('open')));
  document.querySelectorAll('[data-nav-links] a').forEach((a) => a.addEventListener('click', () => set(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
  matchMedia('(min-width: 960px)').addEventListener('change', (e) => e.matches && set(false));
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgba(255, 255, 255, .9); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid #e9eef7; }
  .nav { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; }
  .links { display: flex; gap: 26px; font-size: 14px; font-weight: 500; align-items: center; }
  .links a:not(.btn) { color: var(--muted); white-space: nowrap; padding: 6px 0; }
  .links a:not(.btn):hover { color: var(--ink); }
  .right { display: flex; align-items: center; gap: 10px; }
  .lang-short { display: inline-flex; align-items: center; justify-content: center; min-width: 40px; height: 40px; border: 1px solid #dce4f2; border-radius: 999px; font-size: 13px; font-weight: 700; color: var(--ink-2); }
  .lang { display: none !important; }
  .mobile-cta { display: none; }
  .burger { display: none; width: 44px; height: 44px; border: 1px solid #dce4f2; border-radius: 12px; background: #fff; cursor: pointer; align-items: center; justify-content: center; }
  .bars { display: grid; gap: 4px; }
  .bars i { display: block; width: 18px; height: 2px; border-radius: 2px; background: var(--ink); transition: transform .25s, opacity .2s; }
  .open .bars i:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .open .bars i:nth-child(2) { opacity: 0; }
  .open .bars i:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  @media (max-width: 959px) {
    .burger { display: inline-flex; }
    .desktop-cta { display: none; }
    .links {
      position: fixed; inset: 64px 0 auto 0; height: calc(100dvh - 64px); flex-direction: column; align-items: stretch; gap: 0;
      padding: 12px var(--gutter) 32px; background: #fff; border-top: 1px solid var(--line-2);
      transform: translateY(-8px); opacity: 0; visibility: hidden; transition: opacity .2s, transform .25s var(--ease), visibility .25s; overflow-y: auto;
    }
    .open .links { transform: none; opacity: 1; visibility: visible; }
    .links a:not(.btn) { font-size: 18px; font-weight: 600; color: var(--ink); padding: 14px 4px; border-bottom: 1px solid var(--line-2); }
    .lang { display: flex !important; gap: 8px; align-items: center; }
    .mobile-cta { display: inline-flex; margin-top: 20px; min-height: 52px; font-size: 16px; }
  }
</style>
