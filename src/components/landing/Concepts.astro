---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import tegak from '../../assets/work/tegak.png';
import { getDict } from '../../i18n';
import type { ConceptCopy } from '../../i18n/en';
import { servicePath } from '../../i18n/routes';
import type { Locale } from '../../lib/schemas';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale);
const w = t.work;

// Concepts are demo sites hosted in public/samples/. The shot is a tall full-page capture
// (scripts/capture-portfolio.mjs) that the frame pans through on hover; the card wears the concept's own palette.
const visuals: Record<ConceptCopy['key'], { shot: ImageMetadata; bg: string; fg: string; accent: string; link: string }> = {
  tegak: { shot: tegak, bg: '#17181a', fg: '#f3f1ec', accent: '#e2601b', link: '#f39a63' },
};
---
<div class="concepts stack" data-reveal>
  <div class="head stack">
    <span class="eyebrow">{w.conceptsEyebrow}</span>
    <p class="lead">{w.conceptsLead}</p>
  </div>

  <div class:list={['grid', { multi: w.concepts.length > 1 }]}>
    {w.concepts.map((c) => {
      const v = visuals[c.key];
      return (
        <article class="concept" style={`--bg:${v.bg};--fg:${v.fg};--accent:${v.accent};--link:${v.link}`}>
          <div class="body">
            <span class="cat mono">{c.category}</span>
            <div class="title">
              <h3>{c.name}</h3>
              <span class="type">{c.type}</span>
            </div>
            <p class="quote">“{c.tagline}”</p>
            <p class="desc">{c.desc}</p>
            <ul class="tags">{c.highlights.map((h) => <li>{h}</li>)}</ul>
            <div class="actions">
              <a class="btn btn-sm demo" href={c.url} target="_blank" rel="noopener">{w.demo} ↗</a>
              <a class="similar" href={servicePath(c.service, locale)}>{w.similar}: <b>{t.services_list[c.service].name}</b> →</a>
            </div>
          </div>

          <a class="visual" href={c.url} target="_blank" rel="noopener" aria-label={`${w.demo}: ${c.name}`}>
            <div class="browser frame">
              <div class="browser-bar"><i></i><i></i><i></i><span>{c.host}</span></div>
              <div class="screen">
                <Image src={v.shot} alt={w.desktopAlt(c.name)} widths={[640, 900, 1280]} sizes="(min-width: 1024px) 640px, 100vw" loading="lazy" />
              </div>
            </div>
            <span class="hint"><span class="on-hover"><b aria-hidden="true">↓</b> {w.hoverHint}</span><span class="on-touch">{w.tapHint} ↗</span></span>
          </a>
        </article>
      );
    })}
  </div>
</div>

<style>
  .concepts { gap: 20px; }
  .head { gap: 6px; max-width: 620px; }
  .head .lead { font-size: 15px; }

  .grid { display: grid; gap: 24px; }
  @media (min-width: 1024px) { .grid.multi { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* Dark card in the concept's palette; the browser frame bleeds off its bottom-right edge */
  .concept {
    --pad: 22px;
    position: relative; display: grid; gap: 28px; overflow: hidden; border-radius: 24px; padding: var(--pad) var(--pad) 0;
    background: repeating-linear-gradient(135deg, rgba(255, 255, 255, .035) 0 1px, transparent 1px 12px), var(--bg);
    color: var(--fg); box-shadow: 0 30px 60px rgba(11, 26, 58, .14);
  }
  .concept::before { content: ''; position: absolute; top: 0; left: var(--pad); width: 56px; height: 3px; background: var(--accent); }
  @media (min-width: 640px) { .concept { --pad: 36px; } }
  @media (min-width: 1024px) {
    .grid:not(.multi) .concept { --pad: 48px; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 48px; padding-bottom: var(--pad); }
    .grid:not(.multi) .visual { align-self: end; margin-bottom: calc(var(--pad) * -1); }
  }

  .body { display: flex; flex-direction: column; gap: 14px; min-width: 0; align-self: center; }
  .cat { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
  .title { display: flex; flex-direction: column; gap: 4px; }
  h3 { font-size: clamp(24px, 2.6vw, 30px); letter-spacing: -0.025em; line-height: 1.15; }
  .type { font-size: 14px; color: color-mix(in srgb, var(--fg) 62%, transparent); }
  .quote { font-family: var(--hand); font-size: 25px; line-height: 1.15; color: var(--link); }
  .desc { font-size: 14.5px; line-height: 1.6; color: color-mix(in srgb, var(--fg) 78%, transparent); text-wrap: pretty; }
  .tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags li { font-size: 12.5px; font-weight: 600; color: var(--fg); border: 1px solid color-mix(in srgb, var(--fg) 22%, transparent); border-radius: 999px; padding: 6px 12px; }
  .actions { display: flex; align-items: center; gap: 12px 20px; flex-wrap: wrap; padding-top: 4px; }
  .demo { background: var(--accent); color: #fff; }
  .demo:hover { color: #fff; transform: translateY(-2px); box-shadow: 0 14px 28px color-mix(in srgb, var(--accent) 40%, transparent); }
  .similar { font-size: 13.5px; color: color-mix(in srgb, var(--fg) 62%, transparent); }
  .similar b { color: var(--link); font-weight: 600; }
  .similar:hover { color: var(--fg); }
  @media (max-width: 479px) { .actions .demo { width: 100%; } }

  /* Visual: a fixed-height window onto the tall screenshot */
  .visual { position: relative; display: block; min-width: 0; margin-right: calc(var(--pad) * -1); }
  .frame { border-radius: 14px 0 0 0; background: var(--bg); box-shadow: 0 -10px 44px rgba(0, 0, 0, .35); }
  .frame .browser-bar { background: #fff; }
  .screen { position: relative; aspect-ratio: 16 / 11; overflow: hidden; background: var(--bg); }
  .screen img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 0; transition: object-position 1.4s var(--ease); }
  .screen::after { content: ''; position: absolute; inset: auto 0 0; height: 40%; background: linear-gradient(transparent, color-mix(in srgb, var(--bg) 70%, transparent)); transition: opacity .4s; pointer-events: none; }

  .hint { position: absolute; left: 18px; bottom: 18px; display: inline-flex; font-size: 12.5px; font-weight: 600; color: #fff; background: rgba(0, 0, 0, .55); backdrop-filter: blur(6px); border: 1px solid rgba(255, 255, 255, .16); border-radius: 999px; padding: 7px 14px; transition: opacity .4s; }
  .hint b { display: inline-block; margin-right: 4px; animation: bob 1.6s var(--ease) infinite; }
  .on-hover { display: none; }
  @keyframes bob { 50% { transform: translateY(3px); } }

  @media (hover: hover) {
    .on-hover { display: inline; }
    .on-touch { display: none; }
    .concept:hover .screen img, .visual:focus-visible .screen img { object-position: 50% 100%; transition: object-position 7s cubic-bezier(.45, 0, .3, 1); }
    .concept:hover .screen::after, .concept:hover .hint, .visual:focus-visible .hint { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .concept:hover .screen img, .visual:focus-visible .screen img { object-position: 50% 0; }
    .hint b { animation: none; }
  }
</style>
