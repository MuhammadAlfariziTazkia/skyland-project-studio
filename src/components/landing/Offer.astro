---
import pricing from '../../../data/pricing.json';
import { whatsappLink } from '../../config/site';
import { getDict } from '../../i18n';
import { ROUTES } from '../../i18n/routes';
import { foundingSpotsLeft } from '../../lib/pricing';
import type { Locale } from '../../lib/schemas';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale);
const o = pricing.foundingOffer;
const left = foundingSpotsLeft();
const wa = whatsappLink(locale === 'id' ? 'Halo Skyland, saya tertarik dengan promo klien pertama.' : "Hi Skyland, I'm interested in the founding client offer.");
---
<section id="offer" class="offer">
  <div class="deco d1" aria-hidden="true"></div>
  <div class="deco d2" aria-hidden="true"></div>
  <div class="container inner" data-reveal>
    <span class="tag">{t.offer.eyebrow}</span>
    {left > 0 ? (
      <>
        <h2>{t.offer.title(o.spotsTotal)}</h2>
        <p>{t.offer.lead(o.percent)}</p>
        <div class="spots">
          <div class="bars" aria-hidden="true">{Array.from({ length: o.spotsTotal }, (_, i) => <span class:list={{ taken: i < o.spotsTaken }}></span>)}</div>
          <span>{t.offer.left(left, o.spotsTotal)}</span>
        </div>
      </>
    ) : (
      <>
        <h2>{t.how.title}</h2>
        <p>{t.offer.full}</p>
      </>
    )}
    <div class="ctas">
      <a class="btn claim" href={ROUTES.consult[locale]}>{left > 0 ? t.offer.claim : t.how.cta} →</a>
      {wa && <a class="btn talk" href={wa} target="_blank" rel="noopener">{t.offer.talk}</a>}
    </div>
  </div>
</section>

<style>
  .offer { position: relative; overflow: hidden; background: linear-gradient(135deg, #1d4ed8, #2f6bff); color: #fff; }
  .deco { position: absolute; background: rgba(255, 255, 255, .08); }
  .d1 { right: -60px; top: -60px; width: 260px; height: 260px; border-radius: 60px; transform: rotate(20deg); }
  .d2 { left: -40px; bottom: -80px; width: 220px; height: 220px; border-radius: 50px; transform: rotate(-15deg); background: rgba(255, 255, 255, .06); }
  .inner { position: relative; max-width: 820px; padding-top: 72px; padding-bottom: 72px; display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center; }
  @media (min-width: 768px) { .inner { padding-top: 96px; padding-bottom: 96px; } }
  .tag { background: rgba(255, 255, 255, .14); border: 1px solid rgba(255, 255, 255, .3); font-size: 12px; font-weight: 700; letter-spacing: .1em; padding: 6px 14px; border-radius: 999px; }
  h2 { font-size: clamp(30px, 4vw, 48px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; text-wrap: balance; }
  p { font-size: 17px; color: #dbe6ff; max-width: 560px; line-height: 1.6; }
  .spots { display: flex; align-items: center; gap: 12px; padding: 4px 0; font-size: 14px; font-weight: 600; flex-wrap: wrap; justify-content: center; }
  .bars { display: flex; gap: 6px; }
  .bars span { width: 28px; height: 6px; border-radius: 3px; background: #fff; }
  .bars span.taken { background: rgba(255, 255, 255, .3); }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; padding-top: 6px; width: 100%; }
  .claim { background: #fff; color: #1d4ed8; font-weight: 700; }
  .claim:hover { color: #1d4ed8; transform: translateY(-2px); }
  .talk { color: #fff; border-color: rgba(255, 255, 255, .5); }
  .talk:hover { color: #fff; background: rgba(255, 255, 255, .08); }
  @media (max-width: 479px) { .ctas .btn { flex: 1 1 100%; } }
</style>
