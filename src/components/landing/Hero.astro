---
import { Image } from 'astro:assets';
import heroSiteEn from '../../assets/hero-site-en.png';
import heroSiteId from '../../assets/hero-site-id.png';
import heroSiteJa from '../../assets/hero-site-ja.png';
import { getDict } from '../../i18n';
import { ROUTES } from '../../i18n/routes';
import { demoQuote } from '../../lib/demo';
import { foundingOffer, foundingSpotsLeft, formatPrice } from '../../lib/pricing';
import type { Locale } from '../../lib/schemas';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale);
const offer = foundingOffer;
const spotsLeft = foundingSpotsLeft();
const HERO: Record<Locale, ImageMetadata> = { en: heroSiteEn, id: heroSiteId, ja: heroSiteJa };
const heroSite = HERO[locale];
const demo = demoQuote(locale);
const samplePrice = formatPrice(demo.total, demo.region);
const [planA, planB] = t.hero.planCard;
const [priceA, priceB] = t.hero.priceCard(samplePrice);
---
<section id="top" class="hero">
  <div class="container grid">
    <div class="copy">
      {spotsLeft > 0 && (
        <div class="pill badge" data-anim><span class="dot" aria-hidden="true"></span>{t.hero.badge(offer.percent, offer.spots_total)}</div>
      )}
      <h1 data-anim>{t.hero.titleA} <span class="shimmer">{t.hero.titleB}</span></h1>
      <p class="lead big" data-anim>{t.hero.lead}</p>
      <div class="ctas" data-anim>
        <a class="btn btn-primary" href={ROUTES.consult[locale]}>{t.hero.primary} →</a>
        <a class="btn btn-ghost" href="#work">{t.hero.secondary}</a>
      </div>
      <ul class="checks" data-anim>
        {t.hero.checks.map((c) => <li class="check">{c}</li>)}
      </ul>
    </div>

    <div class="visual" data-anim-visual>
      <div class="glow" aria-hidden="true"></div>
      <div class="float f0">
        <div class="laptop">
          <div class="screen">
            <Image src={heroSite} alt={t.hero.laptopAlt} widths={[480, 720, 960]} sizes="(min-width: 1024px) 540px, 92vw" loading="eager" fetchpriority="high" />
          </div>
          <div class="base" aria-hidden="true"></div>
        </div>
      </div>
      <div class="chip c1 float f1" aria-hidden="true"><span class="ic blue">✦</span><span><b>{planA}</b><br />{planB}</span></div>
      <div class="chip c2 float f2" aria-hidden="true"><span class="ic green">✓</span><span><b>{priceA}</b><br />{priceB}</span></div>
      <p class="note" aria-hidden="true">{t.hero.note[0]}<br />{t.hero.note[1]}</p>
    </div>
  </div>
</section>

<style>
  .hero { background: linear-gradient(180deg, #fff 0%, #edf3ff 100%); overflow: hidden; }
  .grid { display: grid; gap: 40px; align-items: center; padding-top: 40px; padding-bottom: 64px; }
  @media (min-width: 1024px) { .grid { grid-template-columns: 1fr 1fr; gap: 48px; padding-top: 72px; padding-bottom: 96px; } }
  .copy { display: flex; flex-direction: column; gap: 22px; min-width: 0; }
  .badge { align-self: flex-start; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 3px #d5f3e5; flex: none; }
  h1 { font-size: clamp(34px, 5.2vw, 62px); line-height: 1.05; letter-spacing: -0.035em; font-weight: 800; text-wrap: balance; }
  .shimmer { background: linear-gradient(90deg, #2459e0 0%, #6a9bff 25%, #2459e0 50%, #6a9bff 75%, #2459e0 100%); background-size: 200% auto; -webkit-background-clip: text; background-clip: text; color: transparent; animation: shimmer 8s linear infinite; }
  @keyframes shimmer { to { background-position: -200% 50%; } }
  .big { font-size: 17px; max-width: 520px; }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  @media (max-width: 479px) { .ctas .btn { flex: 1 1 100%; } }
  .checks { list-style: none; margin: 0; padding: 4px 0 0; display: flex; gap: 10px 24px; flex-wrap: wrap; font-size: 14px; color: var(--ink-2); }

  .visual { position: relative; padding: 36px 0 64px; min-width: 0; }
  @media (min-width: 640px) { .visual { padding: 30px 10px 60px; } }
  .glow { position: absolute; inset: -40px; background: radial-gradient(circle at 55% 45%, #cddbff 0%, rgba(205, 219, 255, 0) 62%); }
  .laptop { position: relative; }
  @media (min-width: 1024px) { .laptop { transform: perspective(1400px) rotateY(-9deg) rotateX(4deg); } }
  .screen { background: #0f1629; border-radius: 16px 16px 4px 4px; padding: 10px; box-shadow: 0 30px 60px rgba(11, 26, 58, .25); }
  .screen img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top left; border-radius: 6px; }
  .base { height: 12px; margin: 0 -4%; background: linear-gradient(180deg, #d9dee8, #aab2c2); border-radius: 0 0 16px 16px; }
  .chip { position: absolute; display: flex; align-items: center; gap: 10px; background: #fff; padding: 9px 13px; border-radius: 14px; box-shadow: 0 12px 30px rgba(11, 26, 58, .14); font-size: 12px; line-height: 1.35; color: var(--muted); z-index: 2; }
  .chip b { color: var(--ink); }
  .c1 { top: 0; right: 0; }
  .c2 { bottom: 14px; left: 0; }
  .ic { width: 28px; height: 28px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; flex: none; }
  .blue { background: var(--blue-soft); color: var(--blue); }
  .green { background: var(--green-soft); color: var(--green); }
  .note { position: absolute; bottom: 0; right: 10px; font-family: var(--hand); font-size: 24px; line-height: .95; color: var(--blue); transform: rotate(-10deg); text-align: center; }
  @media (max-width: 639px) { .note { display: none; } .chip { font-size: 11px; } }

  .float { animation: float 6s ease-in-out 1.5s infinite; }
  .f1 { animation-duration: 6.9s; animation-delay: 2.1s; }
  .f2 { animation-duration: 7.8s; animation-delay: 2.7s; }
  @keyframes float { 50% { transform: translateY(-10px); } }
</style>
