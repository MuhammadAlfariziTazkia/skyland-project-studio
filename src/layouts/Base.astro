---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import { pairFor } from '../i18n/routes';
import type { Locale } from '../lib/schemas';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  ogAlt: string;
  jsonLd?: object[];
  noindex?: boolean;
}
const props = Astro.props;
/*
 * Twins of this exact page in the other languages, so a visitor lands on the matching page rather than the
 * home page. Only offered from English: /id/ and /ja/ are always reached on purpose, and English is the
 * default. Order matters — the first rule whose signal matches wins.
 */
const altHrefs =
  props.locale === 'en'
    ? [
        { loc: 'ja', href: pairFor(Astro.url.pathname)?.ja ?? null, tz: '^Asia/Tokyo$', lang: '^ja' },
        { loc: 'id', href: pairFor(Astro.url.pathname)?.id ?? null, tz: '^Asia/(Jakarta|Pontianak|Makassar|Jayapura)$', lang: '^id' },
      ].filter((r) => r.href)
    : [];
---
<!doctype html>
<html lang={props.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#2459e0" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo {...props} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script is:inline define:vars={{ altHrefs }}>
  // Pages are prerendered and CDN-cached, so the language choice is made here instead of on the server.
  (function () {
    var KEY = 'skyland-lang';
    // Left over from the currency picker that no longer exists. Nothing reads it any more, but a value
    // stored while it did used to outrank market detection, so it is swept out rather than left behind.
    try { localStorage.removeItem('skyland-market'); } catch (err) {}
    try {
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest && e.target.closest('[data-lang-switch]');
        if (a) localStorage.setItem(KEY, a.getAttribute('hreflang') || '');
      });
    } catch (err) {}
    if (!altHrefs || !altHrefs.length) return;
    try {
      if (localStorage.getItem(KEY)) return; // the visitor picked a language, never override it
      if (/bot|crawl|spider|slurp|preview/i.test(navigator.userAgent)) return; // keep the English pages indexable
      var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
      var langs = navigator.languages || [navigator.language || ''];
      for (var i = 0; i < altHrefs.length; i++) {
        var r = altHrefs[i];
        var here = new RegExp(r.tz).test(tz);
        var speaks = langs.some(function (l) { return new RegExp(r.lang, 'i').test(l); });
        if (here || speaks) {
          location.replace(r.href + location.search + location.hash);
          return;
        }
      }
    } catch (err) {}
  })();
</script>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>import '../scripts/reveal.ts';</script>
  </body>
</html>
